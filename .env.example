# Telegram API credentials (get at https://my.telegram.org)
# All variables are optional — you may also use config.json instead of .env.
#
# DIGEST_API_ID=12345
# DIGEST_API_HASH=your_api_hash_here
# DIGEST_PHONE=+790****4567
#
# Bot token from @BotFather (for publishing to channel)
# DIGEST_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
#
# Target channel: numeric ID (negative) + link for user-session access
# Get ID: python3 collectors/collect.py --get-chat-id https://t.me/your_channel
# DIGEST_TARGET_CHANNEL_ID=-1001234567890
# DIGEST_CHANNEL_LINK=https://t.me/your_channel_or_invite_link
#
# Working directory (default: ~/.hermes/digest)
# DIGEST_DIR=~/.hermes/digest
#
# Optional branding suffix for split messages (e.g. "Мой Дайджест")
# DIGEST_BRAND=Мой Дайджест
